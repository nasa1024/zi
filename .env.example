# ============================================================================
# NovelForge 运行时配置（环境变量）
# ----------------------------------------------------------------------------
# 本系统没有配置文件加载器：运行期配置 = dataclass 默认值 + 环境变量 + 每请求
# API 字段。后端只读 os.environ，不会自动读取本文件。使用方式三选一：
#   1) 手动导出： set -a; source .env; set +a   然后启动服务
#   2) docker：   docker run --env-file .env ...
#   3) systemd：  EnvironmentFile=/path/to/.env
#
# 复制为 .env 后按需取消注释 / 修改。所有值都有安全默认，**全部留空=旧行为不变**。
# ============================================================================


# ── 服务 / 数据 / 鉴权 ───────────────────────────────────────────────────────

# 数据根目录（各项目的 sqlite 库与 L0 草稿落于此）。默认 ./data
# NOVELFORGE_DATA=./data

# REST API 鉴权密钥。仅用于 Bearer / X-API-Key 校验，绝不会作为
# LLM 或 Embedding 的外部服务凭据发送。
# NOVELFORGE_API_KEY=

# 允许的跨域来源（逗号分隔）。默认仅本地。
# NOVELFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── LLM Provider（正文生成 / 抽取 / 评委）────────────────────────────────────

# provider 名：gemini | deepseek | deepseek_anthropic | anthropic | openai_compat | fake
# 不设时按已配置的 key 推断，优先级 GEMINI > DEEPSEEK > ANTHROPIC > OPENAI；
# 显式指定时只使用该 provider 自己的 key，绝不借用其他 provider 的 key。
# NOVELFORGE_PROVIDER=gemini

# LLM 密钥（按 provider 配置；都不设则无法真正调用，仅 fake/降级可跑）。
# GEMINI_API_KEY=xxxxxxxx          # Google AI Studio 付费层 key（免费层不含 Gemini 4）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# 显式 NOVELFORGE_PROVIDER=gemini 时也接受 GOOGLE_API_KEY（过于通用，不参与推断）。


# ── Gemini 4（gemini-4-argon）调参（可选）────────────────────────────────────
# 三档默认同为 gemini-4-argon，以思考强度区分：fast=low / mid=medium / strong=high。
# 失败升级 fast→mid→strong 即同模型加深推理。用 "模型@思考强度" 覆盖任一档：
# NOVELFORGE_FAST_MODEL=gemini-4-argon@low       # 或 gemini-3.8-flash 等更便宜的模型
# NOVELFORGE_MID_MODEL=gemini-4-argon@medium
# NOVELFORGE_STRONG_MODEL=gemini-4-argon@high    # 正文/卷规划；想省钱可改 @medium
#
# 安全过滤阈值（作用于骚扰/仇恨/色情/危险四类）。不设=服务端默认。
# 可选：BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | BLOCK_LOW_AND_ABOVE | OFF
# NOVELFORGE_GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH
#
# 自建代理/网关地址（默认 https://generativelanguage.googleapis.com）。
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
#
# 若要接 OpenAI 兼容端点：NOVELFORGE_PROVIDER=openai_compat + OPENAI_BASE_URL，
# 三档模型同样用 NOVELFORGE_FAST_MODEL / MID / STRONG 指定。


# ── 第三方 Embedding 后端（向量召回用；默认离线 hash，无需配置）──────────────
# 仅当启用向量召回（见下方 ENABLE_VECTOR）时才会真正用到。
# 不设 PROVIDER → 用内置离线 HashEmbedder（零依赖、无网络）。

# embedding provider：hash（默认/离线） | openai（OpenAI 兼容 /v1/embeddings）
# NOVELFORGE_EMBEDDING_PROVIDER=openai

# openai provider 的模型 id（维度由模型决定）。例：
#   text-embedding-3-small / text-embedding-3-large（OpenAI 官方）
#   bge-m3（本地 vLLM / Ollama 暴露的兼容端点）
# NOVELFORGE_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI 兼容端点与密钥；key 留空时只回退到明确的 provider key，
# 不会使用 NOVELFORGE_API_KEY（REST 鉴权密钥）。
# NOVELFORGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# NOVELFORGE_EMBEDDING_API_KEY=sk-xxxxxxxx


# ── 记忆管线 L2/L3 + 向量召回开关（§06；默认全关）──────────────────────────

# L2 场景聚合：每章正文切场景 + 摘要写 l2_scenes（向量召回的语料）。
# 需要"查相似桥段 / 反自我重复"时开；通常与 ENABLE_VECTOR 一起开才有意义。
# NOVELFORGE_ENABLE_L2=false

# L3 事件驱动 canon 提案：确定性扫到 世界规则/新实体/伏笔/约束 时，
# LLM 归一化为提案进 staging（人审兜底，绝不直接 commit）。
# 自动连写(autopilot)/对设定一致性要求高时开。
# NOVELFORGE_ENABLE_L3=false

# 向量召回总开关：开则下一章起草时检索相似 L2 场景注入上下文。
# 开启后会按 EMBEDDING_PROVIDER 构建 embedder（默认 hash）。
# NOVELFORGE_ENABLE_VECTOR=false

# ── L2/向量调参（可选）─────────────────────────────────────────
# L2 触发间隔：每 N 章聚合一次（卷末必触发）。默认 4。
# NOVELFORGE_L2_EVERY_N=4
# 单章最多切几个场景块。默认 6。
# NOVELFORGE_L2_MAX_SCENES=6
# 向量召回返回的相似场景数。默认 8。
# NOVELFORGE_VECTOR_TOP_K=8
# RRF 融合常数 k（§06.4.3）。默认 60。
# NOVELFORGE_RRF_K=60
# HashEmbedder 向量维度（仅 hash provider 用；openai 维度由模型决定）。默认 256。
# NOVELFORGE_EMBEDDING_DIM=256


# ============================================================================
# 配方示例
# ----------------------------------------------------------------------------
# A) 纯离线（默认）：什么都不设 → LLM 需另配；embedding=hash；L2/L3/向量关。
#
# G) Gemini 4 写正文（1M 统一上下文 + long decode 长输出，卷规划单次 ≤30 章）：
#      NOVELFORGE_PROVIDER=gemini
#      GEMINI_API_KEY=xxx
#      NOVELFORGE_ENABLE_L2=true
#      NOVELFORGE_ENABLE_VECTOR=true
#
# B) DeepSeek 写正文 + 开 L2/L3/向量（离线 hash embedding，零额外依赖）：
#      NOVELFORGE_PROVIDER=deepseek
#      DEEPSEEK_API_KEY=sk-xxx
#      NOVELFORGE_ENABLE_L2=true
#      NOVELFORGE_ENABLE_L3=true
#      NOVELFORGE_ENABLE_VECTOR=true
#
# C) DeepSeek 写正文 + OpenAI embeddings 做语义向量召回：
#      NOVELFORGE_PROVIDER=deepseek
#      DEEPSEEK_API_KEY=sk-deepseek
#      NOVELFORGE_ENABLE_L2=true
#      NOVELFORGE_ENABLE_VECTOR=true
#      NOVELFORGE_EMBEDDING_PROVIDER=openai
#      NOVELFORGE_EMBEDDING_MODEL=text-embedding-3-small
#      NOVELFORGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
#      NOVELFORGE_EMBEDDING_API_KEY=sk-openai
# ============================================================================
